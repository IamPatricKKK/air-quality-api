# Web người dùng
airquality.info.vn {
	reverse_proxy fe:80
}

# API NestJS (REST + WebSocket realtime — Caddy tự xử lý WebSocket)
api.airquality.info.vn {
	reverse_proxy api:3002
}

# Trang quản trị
admin.airquality.info.vn {
	reverse_proxy admin:80
}

# Backend phân tích / dự báo (Python FastAPI)
be.airquality.info.vn {
	reverse_proxy be:8000
}
