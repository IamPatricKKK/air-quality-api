# ============================================================
#  PRODUCTION .env — deploy/.env  (KHÔNG commit file .env thật)
#  Copy file này thành .env rồi điền giá trị thật.
# ============================================================

# Domain gốc (không có https://). Các subdomain api./admin./be. tự ghép.
DOMAIN=airquality.info.vn

# ----- PostgreSQL (nội bộ, không mở ra ngoài) -----
POSTGRES_USER=airquality
POSTGRES_PASSWORD=__ĐỔI_MẬT_KHẨU_MẠNH__
POSTGRES_DB=sky_pulse

# ----- JWT (RS256) — BẮT BUỘC đặt key thật, KHÔNG để 'change-me' -----
# PEM để trên 1 dòng, xuống dòng thay bằng \n  (code tự chuyển \n thành newline)
JWT_ISSUER=air-quality-api
JWT_AUDIENCE=air-quality-clients
JWT_ACCESS_TTL_SECONDS=28800
JWT_SECRET=__chuỗi_ngẫu_nhiên_dài__
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# ----- CORS / Frontend -----
FRONTEND_URL=https://airquality.info.vn
CORS_ORIGINS=https://airquality.info.vn,https://admin.airquality.info.vn

# ----- OAuth Google (cùng Client ID cho FE & Admin) -----
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=letruongle325@gmail.com
SMTP_PASS=__app_password_16_ký_tự__
SMTP_FROM=Chất Lượng Không Khí VN <letruongle325@gmail.com>

# ----- Web Push (VAPID) -----
VAPID_PUBLIC_KEY=__vapid_public__
VAPID_PRIVATE_KEY=__vapid_private__
VAPID_SUBJECT=mailto:admin@airquality.info.vn

# ----- API keys nguồn dữ liệu -----
WAQI_TOKEN=__waqi_token__
IQAIR_API_KEY=
OPENWEATHER_API_KEY=

# ----- Lịch cronjob -----
INGEST_ENABLED=true
INGEST_CRON=0 */12 * * *
ALERT_CRON=*/30 * * * *
ADMIN_DIGEST_CRON=0 8 * * *

# ----- Python BE (phân tích/dự báo) -----
ANALYTICS_ENABLED=true
ANALYTICS_SUMMARY_CRON=0 1 * * *
ANALYTICS_ANOMALY_CRON=0 */6 * * *
ANALYTICS_FORECAST_CRON=0 2 * * *
