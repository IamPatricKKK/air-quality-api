# Caddy reverse proxy — tự động HTTPS (Let's Encrypt).
# Route theo network alias của từng service trên mạng airquality_prod.

{
	email letruongle325@gmail.com
}

airquality.info.vn {
	reverse_proxy fe:80
}

api.airquality.info.vn {
	reverse_proxy api:3002
}

# Môi trường stage cho FE dev chạy local trỏ tới (DB riêng sky_pulse_stage).
stage.api.airquality.info.vn {
	reverse_proxy api-stage:3002
}

admin.airquality.info.vn {
	reverse_proxy admin:80
}

be.airquality.info.vn {
	reverse_proxy be:8000
}

liveroom.deev.io.vn {
	reverse_proxy liveroom-web:3000
}

api.liveroom.deev.io.vn {
	reverse_proxy liveroom-api:4000
}
