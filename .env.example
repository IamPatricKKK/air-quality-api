PORT=3002

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sky_pulse
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sky_pulse
JWT_ISSUER=air-quality-api
JWT_AUDIENCE=air-quality-clients
JWT_ACCESS_TTL_SECONDS=28800
JWT_SECRET=change-me
JWT_PUBLIC_KEY=change-me
JWT_PRIVATE_KEY=change-me

# ----- OAuth đăng nhập (Google / Facebook) — TÙY CHỌN -----
# Để trống = tắt; endpoint /auth/google trả 503 "chưa cấu hình".
# Google: tạo OAuth 2.0 Client ID (Web) tại https://console.cloud.google.com
#   Authorized JS origins: http://localhost:5173, http://localhost:5174 + domain prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook (tùy chọn): https://developers.facebook.com → Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ----- Frontend URL (links trong email) -----
# URL của air-quality-fe. Dùng để build link trong email gửi cho user:
#   - Xác thực email đăng ký:  {FRONTEND_URL}/auth/verify?token=...
#   - Đặt lại mật khẩu:        {FRONTEND_URL}/auth/reset?token=...
# Mặc định http://localhost:5173 nếu không set. PRODUCTION: phải đặt domain thật,
# nếu sai thì link trong email sẽ trỏ về localhost và user không bấm được.
FRONTEND_URL=http://localhost:5173

# ----- Web Push (VAPID) -----
# Tạo cặp khóa 1 lần: `npx web-push generate-vapid-keys` rồi dán vào dưới.
# Public key cũng cần copy sang FE: VITE_VAPID_PUBLIC_KEY trong air-quality-fe/.env
# Private key KHÔNG bao giờ được commit hay share.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@air-quality.local

# ----- Ingest master switch & cron -----
# Bật/tắt TOÀN BỘ scheduler ingest (true/false)
INGEST_ENABLED=true
# Cron chạy runAll() — gom IQAir + OpenWeather + Open-Meteo + WAQI theo priority
# Mặc định 12h/lần; các provider có cron riêng được quản trong code (xem ingest.service.ts)
INGEST_CRON=0 */12 * * *

# ----- IQAir (AirVisual) — provider CHÍNH (priority 50) -----
# Đăng ký API key tại: https://www.iqair.com/air-pollution-data-api
# Free tier: 10,000 requests/month (community plan, ~5 req/min)
# ~40 stations × 4 cycles/day × 30 = ~4,800/tháng → an toàn trong quota
IQAIR_API_KEY=
IQAIR_CRON=0 */6 * * *

# ----- OpenWeatherMap — provider PHỤ (priority 150) -----
# Đăng ký API key tại: https://openweathermap.org/api (plan "Free")
# Free tier: 1,000 calls/day, 60 calls/minute
OPENWEATHER_API_KEY=
OPENWEATHER_CRON=0 */3 * * *

# ----- Open-Meteo — provider tham khảo (không cần key) -----
# Số giờ dữ liệu quá khứ lấy mỗi lần (tối đa 168 = 7 ngày)
OPENMETEO_PAST_HOURS=24

# ----- WAQI (World Air Quality Index) — provider tham khảo -----
# Đăng ký token miễn phí tại: https://aqicn.org/data-platform/token/
# Nếu không set WAQI_TOKEN thì bỏ qua WAQI ingest
WAQI_TOKEN=

# ----- Alerts -----
# Cron chạy evaluate alerts mỗi 30 phút
ALERT_CRON=*/30 * * * *

# ----- Email (SMTP) -----
# Dùng cho: xác thực email đăng ký, gửi lại link xác thực, reset mật khẩu,
# và thông báo cảnh báo chất lượng không khí qua email.
# Nếu thiếu SMTP_HOST/SMTP_USER/SMTP_PASS → email bị tắt (chỉ log link ra console).
#
# GMAIL: KHÔNG dùng mật khẩu đăng nhập thường. Phải bật 2FA rồi tạo "App Password"
#   16 ký tự tại https://myaccount.google.com/apppasswords (bỏ hết khoảng trắng).
#   SMTP_USER và địa chỉ trong SMTP_FROM phải GIỐNG NHAU (Gmail chặn spoofing).
# Cổng 587 = STARTTLS (mặc định). Nếu mạng chặn, đổi SMTP_PORT=465 (SSL).
#
# Production trên VPS/Cloud: nên dùng SendGrid/Mailgun thay Gmail (Gmail hay
#   chặn IP server). Ví dụ SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey,
#   SMTP_PASS=<API key>.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Chất Lượng Không Khí Việt Nam <your-email@gmail.com>
