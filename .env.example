PORT=3002

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sky_pulse
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sky_pulse
JWT_ISSUER=air-quality-api
JWT_AUDIENCE=air-quality-clients
JWT_ACCESS_TTL_SECONDS=28800
JWT_SECRET=change-me
JWT_PUBLIC_KEY=change-me
JWT_PRIVATE_KEY=change-me

# ----- Ingest Open-Meteo -----
# Bật/tắt scheduler ingest (true/false)
INGEST_ENABLED=true
# Cron chạy mỗi 12h (00:00 và 12:00)
INGEST_CRON=0 */12 * * *
# Số giờ dữ liệu quá khứ lấy mỗi lần (tối đa 168 = 7 ngày)
OPENMETEO_PAST_HOURS=24

# ----- WAQI (World Air Quality Index) -----
# Đăng ký token miễn phí tại: https://aqicn.org/data-platform/token/
# Nếu không set WAQI_TOKEN thì chỉ ingest từ Open-Meteo
WAQI_TOKEN=

# ----- Alerts -----
# Cron chạy evaluate alerts mỗi 30 phút
ALERT_CRON=*/30 * * * *

# ----- Email (SMTP) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=AirWatch Vietnam <your-email@gmail.com>
